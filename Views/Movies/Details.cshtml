@{
    ViewBag.Title = "Detailed Film Ledger";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Action Navigation Bar -->
<div class="row" style="margin-top: 20px;">
    <div class="col-md-12">
        <div class="pull-right">
            <a href="@Url.Action("Index", "Movies")" class="btn btn-default">
                <span class="glyphicon glyphicon-arrow-left"></span> Back to Dashboard
            </a>
        </div>
        <h2 id="page-film-title">Loading Movie Ledger...</h2>
        <p class="text-muted">Comprehensive catalog metadata and associated actor registry profiles.</p>
        <hr />

        <!-- Loading State Feedback Matrix -->
        <div id="details-loading" class="alert alert-info">
            <span class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span> Pulling relational data streams from repository...
        </div>
    </div>
</div>

<!-- Main Display Workspace (Hidden initially while loading) -->
<div id="details-content" style="display: none;">
    <div class="row">
        <!-- Left Workspace Pane: Synopsis & Specs -->
        <div class="col-md-7">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><span class="glyphicon glyphicon-align-left"></span> Synopsis & Features</h3>
                </div>
                <div class="panel-body">
                    <p id="view-film-desc" class="well text-justify" style="min-height: 120px; font-size: 14px; line-height: 1.6;"></p>

                    <table class="table table-striped table-bordered">
                        <tbody>
                            <tr><td style="width: 30%;"><strong>Original Language:</strong></td><td id="view-film-lang"></td></tr>
                            <tr><td><strong>Running Runtime:</strong></td><td id="view-film-runtime"></td></tr>
                            <tr><td><strong>Official Release:</strong></td><td id="view-film-release"></td></tr>
                            <tr><td><strong>Content Rating:</strong></td><td><span id="view-film-rating" class="label label-danger" style="font-size: 12px; padding: 4px 8px;"></span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Workspace Pane: Corporate & Financials -->
        <div class="col-md-5">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><span class="glyphicon glyphicon-globe"></span> Production Matrix</h3>
                </div>
                <div class="panel-body">
                    <strong>Director Structure:</strong>
                    <span id="view-film-dir" style="font-size: 15px; display: block; margin: 4px 0 2px 0;"></span>
                    <small class="text-muted" style="display: block; margin-bottom: 10px;">
                        Gender Identity: <span id="view-film-dirgender"></span> | DOB: <span id="view-film-dirbirth"></span>
                    </small>

                    <hr style="margin: 10px 0;" />

                    <strong>Studio Entity:</strong> <span id="view-film-studio" class="pull-right text-primary"></span><br />
                    <strong>Origin Country:</strong> <span id="view-film-country" class="pull-right"></span>

                    <hr style="margin: 10px 0;" />

                    <h4 style="margin-top: 15px; margin-bottom: 12px;"><span class="glyphicon glyphicon-usd"></span> Financial Statement</h4>
                    <ul class="list-group" style="margin-bottom: 0;">
                        <li class="list-group-item">
                            <span class="text-muted">Allocated Budget:</span>
                            <strong id="view-film-budget" class="pull-right"></strong>
                        </li>
                        <li class="list-group-item">
                            <span class="text-muted">Box Office Gross:</span>
                            <strong id="view-film-gross" class="pull-right text-success"></strong>
                        </li>
                        <li class="list-group-item">
                            <span class="text-muted">Total Global Accolades / Awards:</span>
                            <span id="view-film-awards" class="badge pull-right" style="background-color: #f0ad4e;"></span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Full-Width Section: Cast Collection Subgrid -->
    <div class="row" style="margin-top: 15px;">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <span class="glyphicon glyphicon-user"></span> Primary Billed Cast Registry
                        <span id="view-actor-count" class="badge pull-right">0 Players</span>
                    </h3>
                </div>
                <div class="panel-body">
                    <table class="table table-striped table-bordered table-hover" style="width: 100%; margin-bottom: 0;">
                        <thead>
                            <tr>
                                <th style="width: 15%;">Performer ID</th>
                                <th style="width: 30%;">Actor Name</th>
                                <th style="width: 30%;">Character Persona Assignment</th>
                                <th style="width: 25%;">Demographics (Gender / Birthdate)</th>
                            </tr>
                        </thead>
                        <tbody id="view-actors-tbody">
                            <!-- Injected dynamically via child data map loops -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            // Read target identification compiled via Razor server parameters
            var targetMovieId = '@ViewBag.MovieId';
            var dynamicCurrency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

            if (!targetMovieId) {
                $('#details-loading').removeClass('alert-info').addClass('alert-danger').text("Error: Missing target parameter identity rules.");
                return;
            }

            // Fire AJAX runtime loop targeting the new JSON endpoint
            $.ajax({
                url: '@Url.Action("GetFilmDetailsJson", "Movies")',
                type: 'GET',
                data: { id: targetMovieId },
                dataType: 'json',
                success: function (movie) {
                    if (movie.success === false) {
                        $('#details-loading').removeClass('alert-info').addClass('alert-danger').text(movie.message);
                        return;
                    }

                    // 1. Map parent identity items inside layout structures
                    $('#page-film-title').text(movie.Title);
                    $('#view-film-desc').text(movie.Description || "No synopsis has been provided for this film entry.");
                    $('#view-film-lang').text(movie.Language);
                    $('#view-film-runtime').text(movie.Runtime + " Minutes");
                    $('#view-film-release').text(processJsonDateString(movie.ReleaseDate));

                    if (movie.Rating) {
                        $('#view-film-rating').text(movie.Rating).show();
                    } else {
                        $('#view-film-rating').text("Unrated").removeClass('label-danger').addClass('label-default');
                    }

                    // 2. Map tracking matrix properties
                    $('#view-film-dir').text(movie.Director);
                    $('#view-film-dirgender').text(movie.DirectorGender);
                    $('#view-film-dirbirth').text(processJsonDateString(movie.DirectorBirthDay));
                    $('#view-film-studio').text(movie.Studio);
                    $('#view-film-country').text(movie.Country);

                    // 3. Map numerical calculations using currency layers
                    $('#view-film-budget').text(dynamicCurrency.format(movie.Budget));
                    $('#view-film-gross').text(dynamicCurrency.format(movie.Gross));
                    $('#view-film-awards').text(movie.Awards);

                    // 4. Loop mapping sequence across nested collection models
                    var castRows = '';
                    $('#view-actor-count').text((movie.Actors ? movie.Actors.length : 0) + " Players");

                    if (movie.Actors && movie.Actors.length > 0) {
                        $.each(movie.Actors, function (i, actor) {
                            castRows += '<tr>';
                            castRows += '  <td><code>' + actor.Id + '</code></td>';
                            castRows += '  <td><strong style="color: #2c3e50;">' + actor.Name + '</strong></td>';
                            castRows += '  <td class="text-primary"><strong>' + actor.Character + '</strong></td>';
                            castRows += '  <td>' + actor.Gender + ' <span class="text-muted" style="font-size:11px;">(DOB: ' + processJsonDateString(actor.Birthdate) + ')</span></td>';
                            castRows += '</tr>';
                        });
                    } else {
                        castRows = '<tr><td colspan="4" class="text-center text-muted" style="padding:20px;">No associated performer profiles have been mapped to this movie ledger.</td></tr>';
                    }

                    $('#view-actors-tbody').html(castRows);

                    // Toggle visibility layers
                    $('#details-loading').hide();
                    $('#details-content').fadeIn(300);
                },
                error: function (xhr, status, error) {
                    $('#details-loading').removeClass('alert-info').addClass('alert-danger').text("Failed to execute data pipeline parsing operations: " + error);
                }
            });

            // Serialized date string parsing fallback utility tool
            function processJsonDateString(jsonTextValue) {
                if (!jsonTextValue) return "N/A";
                var valueExtract = parseInt(jsonTextValue.replace(/(^.*\(|\).*$)/g, ''));
                if (isNaN(valueExtract) || valueExtract < 0) return "N/A";
                var constructedDate = new Date(valueExtract);
                return constructedDate.toISOString().split('T')[0];
            }
        });
    </script>
}