@model AspGodPractice.ViewModels.Movies.MovieRentalViewModel
@{
    ViewBag.Title = "Random";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">

    <div class="row">
        <div class="col-md-6">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title">Current Movie</h3>
                </div>
                <div class="panel-body">
                    <h4><strong>Name:</strong> @Model.Movie.Title</h4>
                    <p><strong>Movie ID:</strong> @Model.Movie.Id</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="alert alert-info">
                <strong>Status:</strong> @Model.NotificationMessage
            </div>
        </div>
    </div>

    <hr />

    <h3>Available Customers for Rental</h3>

    @if (!Model.Customers.Any())
    {
        <p>No customers are currently available in the system.</p>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>@customer.FirstName @customer.LastName</td>
                        <td>
                            @if (customer.IsSubscribed)
                            {
                                <span class="label label-success">Subscribed</span>
                            }
                            else
                            {
                                <span class="label label-default">Guest</span>
                            }
<td>
                            <button class="btn btn-sm btn-default">Rent to This Customer</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
