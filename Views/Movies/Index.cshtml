<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
@model AspGodPractice.ViewModels.Movies.MoviesViewModel

@{
    ViewBag.Title = "Movies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:30px;">

    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="page-header">
                    <h1>@Model.PageHeader <small>(Total: @Model.TotalMovieCount)</small></h1>
                </div>
                <div class="table-responsive">
                    <table id="movieTable" class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Director</th>
                                <th>Release Date</th>
                                <th>Runtime</th>
                                <th>Rating</th>
                                <th>Awards</th>
                                <th>Country</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Movies != null && Model.Movies.Any())
                            {
                                foreach (var movie in Model.Movies)
                                {
                                    <tr>
                                        <td title="@movie.Description">
                                            <a href="@Url.Action("Details", "Movies", new { id = movie.Id })" style="text-decoration:none; color:inherit;">
                                                <strong class="text-primary">@movie.Title</strong>
                                            </a>
                                            <br />
                                            <small class="text-muted">@movie.Studio | @movie.Language</small>
                                        </td>
                                        <td>@movie.Director</td>
                                        <td>@movie.ReleaseDate.ToString("MMM dd, yyyy")</td>
                                        <td>@movie.Runtime mins</td>
                                        <td>
                                            <span class="label label-info">@movie.Rating</span>
                                        </td>
                                        <td>
                                            <span class="badge" style="background-color: #f0ad4e;">@movie.Awards <i class="glyphicon glyphicon-star"></i></span>
                                        </td>
                                        <td>@movie.Country</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center">No movies found in the database.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#movieTable').DataTable({
                "paging": true,          // Adds Pagination
                "ordering": true,        // Adds Sorting
                "info": true,            // Shows "Showing 1 of 10 entries"
                "searching": true,       // Adds Search Bar
                "pageLength": 10,        // Default rows per page
                "language": {
                    "search": "Filter Movies:", // Custom search label
                    "emptyTable": "No films found in the archive"
                },
                "columnDefs": [
                    { "orderable": false, "targets": [0] } // Optional: disable sorting on Title column
                ]
            });

            // Keep your tooltip initialization too
            $('[title]').tooltip();
        });
    </script>
}
