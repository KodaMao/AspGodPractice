@{
    ViewBag.Title = "Cinema Management Engine";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Include Core DataTables CSS Dependencies mapped over Bootstrap layout frames -->
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap.min.css" />

<div class="row" style="margin-top: 20px;">
    <div class="col-md-12">
        <h2>Movie Catalog Dashboard</h2>
        <hr />

        <div id="loading-state" class="alert alert-info">
            <span class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span> Loading movie database...
        </div>

        <!-- Table structural footprint altered to blend with DataTables extensions -->
        <table id="catalog-table" class="table table-striped table-bordered table-hover" style="width:100%; display:none;">
            <thead>
                <tr>
                    <th style="width: 45%;">Movie Details</th>
                    <th style="width: 20%;">Studio & Origin</th>
                    <th style="width: 15%;">Director</th>
                    <th style="width: 20%;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="catalog-tbody">
                <!-- Elements injected via jQuery mapping loops -->
            </tbody>
        </table>
    </div>
</div>

<!-- Movie Details Presentation Modal Container -->
<div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="detailsModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="modal-film-title" style="font-weight: bold; color: #2c3e50;">Production Ledger</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-7">
                        <h4>Synopsis</h4>
                        <p id="modal-film-desc" class="well text-justify" style="min-height: 110px; line-height: 1.5;"></p>

                        <table class="table table-striped table-bordered">
                            <tr><td style="width: 35%;"><strong>Language:</strong></td><td id="modal-film-lang"></td></tr>
                            <tr><td><strong>Runtime:</strong></td><td id="modal-film-runtime"></td></tr>
                            <tr><td><strong>Release Date:</strong></td><td id="modal-film-release"></td></tr>
                            <tr><td><strong>Content Rating:</strong></td><td><span id="modal-film-rating" class="label label-danger" style="font-size: 12px;"></span></td></tr>
                        </table>
                    </div>

                    <div class="col-md-5">
                        <h4>Production & Financials</h4>
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <strong>Director:</strong> <span id="modal-film-dir"></span>
                                <hr style="margin:10px 0;" />
                                <strong>Studio:</strong> <span id="modal-film-studio" class="pull-right"></span><br />
                                <strong>Country:</strong> <span id="modal-film-country" class="pull-right"></span>
                                <hr style="margin:10px 0;" />
                                <strong>Budget:</strong> <span id="modal-film-budget" class="pull-right"></span><br />
                                <strong>Box Office Gross:</strong> <span id="modal-film-gross" class="pull-right text-success" style="font-weight: bold;"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <h4>Billed Cast Registry (<span id="actor-count" class="badge">0</span>)</h4>
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 35%;">Actor Name</th>
                            <th style="width: 35%;">Character Assignment</th>
                            <th style="width: 30%;">Demographics</th>
                        </tr>
                    </thead>
                    <tbody id="modal-actors-tbody">
                        <!-- Iterative elements mapped via child logic loops -->
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery-3.7.0.min.js")"></script>

    <script src="@Url.Content("~/Scripts/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Scripts/dataTables.bootstrap.min.js")"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            var dynamicCurrency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

            // 1. STREAM ALL RECORD REGISTRIES ON LOAD
            $.ajax({
                url: '@Url.Action("GetMoviesJson", "Movies")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    if (!data || data.length === 0) {
                        $('#loading-state').removeClass('alert-info').addClass('alert-warning').text("No records returned from repository endpoint.");
                        return;
                    }

                    var htmlRows = '';

                    $.each(data, function (index, movie) {
                        htmlRows += '<tr>';
                        htmlRows += '  <td>';
                        htmlRows += '     <strong style="font-size:15px; color:#2c3e50;">' + movie.Title + '</strong> ';
                        if (movie.Rating) {
                            htmlRows += '     <span class="label label-danger">' + movie.Rating + '</span>';
                        }
                        htmlRows += '  </td>';
                        htmlRows += '  <td>' + movie.Studio + ' <span class="text-muted">(' + movie.Country + ')</span></td>';
                        htmlRows += '  <td>' + movie.Director + '</td>';
                        htmlRows += '  <td class="text-center" style="vertical-align:middle;">';
                        htmlRows += '      <div class="btn-group" role="group">';
                        // High Contrast Button 1: Info Blue
                        htmlRows += '          <button type="button" class="btn btn-info btn-sm inspect-details-btn" data-id="' + movie.Id + '" style="font-weight:bold;">';
                        htmlRows += '              <span class="glyphicon glyphicon-eye-open"></span> Quick View';
                        htmlRows += '          </button>';
                        // High Contrast Button 2: Success Green
                        htmlRows += '          <button type="button" class="btn btn-success btn-sm redirect-details-btn" data-id="' + movie.Id + '" style="font-weight:bold;">';
                        htmlRows += '              <span class="glyphicon glyphicon-new-window"></span> View Page';
                        htmlRows += '          </button>';
                        htmlRows += '      </div>';
                        htmlRows += '  </td>';
                        htmlRows += '</tr>';
                    });

                    $('#catalog-tbody').html(htmlRows);
                    $('#loading-state').hide();
                    $('#catalog-table').show();

                    $('#catalog-table').DataTable({
                        "paging": true,
                        "lengthChange": true,
                        "searching": true,
                        "ordering": true,
                        "info": true,
                        "autoWidth": false,
                        "pageLength": 10,
                        "columnDefs": [
                            { "orderable": false, "targets": 3 }
                        ]
                    });
                },
                error: function (xhr, status, error) {
                    $('#loading-state').removeClass('alert-info').addClass('alert-danger').text("Error retrieving data: " + error);
                }
            });

            // 2. RETRIEVE NESTED CHILD DATA ARRAYS BY ID (QUICK MODAL WINDOW VIEW)
            $(document).on('click', '.inspect-details-btn', function () {
                var chosenId = $(this).data('id');
                var $btnInstance = $(this);

                $btnInstance.prop('disabled', true).text('Loading...');

                $.ajax({
                    url: '@Url.Action("GetFilmDetailsJson", "Movies")',
                    type: 'GET',
                    data: { id: chosenId },
                    dataType: 'json',
                    success: function (movie) {
                        if (movie.success === false) {
                            alert(movie.message);
                            return;
                        }

                        $('#modal-film-title').text(movie.Title);
                        $('#modal-film-desc').text(movie.Description || "No synopsis available.");
                        $('#modal-film-lang').text(movie.Language);
                        $('#modal-film-runtime').text(movie.Runtime + " Mins");
                        $('#modal-film-release').text(processJsonDateString(movie.ReleaseDate));
                        $('#modal-film-rating').text(movie.Rating || "Unrated");
                        $('#modal-film-dir').text(movie.Director);
                        $('#modal-film-studio').text(movie.Studio);
                        $('#modal-film-country').text(movie.Country);

                        $('#modal-film-budget').text(dynamicCurrency.format(movie.Budget));
                        $('#modal-film-gross').text(dynamicCurrency.format(movie.Gross));

                        var collectionRows = '';
                        $('#actor-count').text(movie.Actors ? movie.Actors.length : 0);

                        if (movie.Actors && movie.Actors.length > 0) {
                            $.each(movie.Actors, function (i, actor) {
                                collectionRows += '<tr>';
                                collectionRows += '  <td><strong>' + actor.Name + '</strong></td>';
                                collectionRows += '  <td class="text-primary"><strong>' + actor.Character + '</strong></td>';
                                collectionRows += '  <td>' + actor.Gender + ' <span class="text-muted" style="font-size:11px;">(DOB: ' + processJsonDateString(actor.Birthdate) + ')</span></td>';
                                collectionRows += '</tr>';
                            });
                        } else {
                            collectionRows = '<tr><td colspan="3" class="text-center text-muted">No associated cast profiles exist for this movie.</td></tr>';
                        }

                        $('#modal-actors-tbody').html(collectionRows);
                        $('#detailsModal').modal('show');
                    },
                    complete: function() {
                        $btnInstance.prop('disabled', false).html('<span class="glyphicon glyphicon-eye-open"></span> Quick View');
                    },
                    error: function () {
                        alert("An error occurred trying to parse data payload.");
                    }
                });
            });

            // 3. COMPLETE ACTION BUTTON REDIRECTION ROUTE TO DEDICATED VIEW PAGE
            $(document).on('click', '.redirect-details-btn', function () {
                var movieId = $(this).data('id');
                window.location.href = '@Url.Action("Details", "Movies")/' + movieId;
            });

            // 4. CONVERT SERIALIZED MS DATE OBJECT STRINGS (/Date(XXXXXXXX)/)
            function processJsonDateString(jsonTextValue) {
                if (!jsonTextValue) return "N/A";
                var valueExtract = parseInt(jsonTextValue.replace(/(^.*\(|\).*$)/g, ''));
                if (isNaN(valueExtract) || valueExtract < 0) return "N/A";
                var constructedDate = new Date(valueExtract);
                return constructedDate.toISOString().split('T')[0];
            }
        });
    </script>
}